#!/usr/bin/env bash

# Source this file from an interactive Borg shell:
#
#   source scripts/setenv.borg
#
# It prepares a clean, reproducible Borg environment for gHALO GPU builds and
# runs without setting user-specific paths.

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  printf 'scripts/setenv.borg must be sourced, not executed.\n' >&2
  exit 1
fi

if ! type module >/dev/null 2>&1; then
  printf 'Borg environment setup requires the environment modules command.\n' >&2
  return 1
fi

selected_rocm_version="${GHALO_ROCM_VERSION:-7.2.0}"

module purge
module load PrgEnv-cray
module load craype-x86-trento
module load craype-accel-amd-gfx90a
module load "rocm/${selected_rocm_version}"
module load rccl-net-plugin/1.0
module load miniforge3/26.1.0-0
if [[ -n "${CRAY_MPICH_ROOTDIR:-}" &&
	      -d "${CRAY_MPICH_ROOTDIR}/ofi/amd/7.0/lib" ]]; then
    export LD_LIBRARY_PATH="${CRAY_MPICH_ROOTDIR}/ofi/amd/7.0/lib:${LD_LIBRARY_PATH}"
fi

export LD_LIBRARY_PATH="${ROCM_PATH}/lib:${LD_LIBRARY_PATH}"
export MPICH_GPU_SUPPORT_ENABLED=1
# Borg MPI-HIP workaround:
# # Cray MPICH CH4 shared-memory single-copy path fails with
# # process_vm_readv: Bad address on MI250X GPU buffers.
# # Disable it and use the safe path.
export MPICH_SMP_SINGLE_COPY_MODE=NONE

export GHALO_SYSTEM_NAME=borg
export GHALO_ROCM_VERSION="${selected_rocm_version}"
export GHALO_LOADED_ROCM_MODULE="rocm/${selected_rocm_version}"

if [[ -n "${ROCM_PATH:-}" ]]; then
  export HIP_PATH="${ROCM_PATH}"
  export RCCL_ROOT="${ROCM_PATH}"
fi

printf 'gHALO Borg environment prepared with rocm/%s.\n' "${selected_rocm_version}"
